# 1. Hapus node_modules dan lockfile lama (jika ada sisa)
rm -rf node_modules package-lock.json

# 2. Generate lockfile baru
npm install

# 3. Pastikan package-lock.json terbentuk
ls -la package-lock.json

# 4. Commit dan push
git add package-lock.json
git commit -m "Add package-lock.json for Railway npm ci"
git push origin main
